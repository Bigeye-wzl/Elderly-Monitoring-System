  deps = [
    "//device/rockchip/hardware:hardware",
    "//kernel/liteos_m/kal/posix",
    "//device/rockchip/rk2206/adapter/hals/communication/wifi_lite/wifiservice:wifiservice",
    "//utils/native/lite/kv_store/src:utils_kv_store",
